<?xml version='1.0' encoding='UTF-8'?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" demote-non-dropping-particle="never" default-locale="pt-BR">

  <info>
    <title>ABNT NBR 6023:2025 + NBR 10520:2023</title>
    <title-short>ABNT 6023:2025 + 10520:2023 nomes completos</title-short>
    <id>https://openai.com/styles/abnt-nbr-6023-2025-corrigido-mendeley</id>
    <link href="https://openai.com/styles/abnt-nbr-6023-2025-corrigido-mendeley" rel="self"/>
    <author>
      <name>Adaptação técnica baseada na ABNT NBR 6023:2025</name>
    </author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <summary>Referências conforme ABNT NBR 6023:2025 e sistema autor-data de citações ajustado à ABNT NBR 10520:2023.</summary>
    <updated>2026-08-11T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="pt-BR">
    <terms>
      <term name="month-01" form="short">jan.</term>
      <term name="month-02" form="short">fev.</term>
      <term name="month-03" form="short">mar.</term>
      <term name="month-04" form="short">abr.</term>
      <term name="month-05" form="short">maio</term>
      <term name="month-06" form="short">jun.</term>
      <term name="month-07" form="short">jul.</term>
      <term name="month-08" form="short">ago.</term>
      <term name="month-09" form="short">set.</term>
      <term name="month-10" form="short">out.</term>
      <term name="month-11" form="short">nov.</term>
      <term name="month-12" form="short">dez.</term>
    </terms>
  </locale>

  <!-- AUTORIA DA BIBLIOGRAFIA:
       A NBR 6023:2025 recomenda indicar todos os autores quando houver quatro ou mais,
       embora permita primeiro autor + et al. Aqui foi adotada a forma preferencial: todos. -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; " delimiter-precedes-last="always" initialize="false">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text macro="title-no-author"/>
      </substitute>
    </names>
  </macro>

  <!-- CITAÇÃO autor-data. Mantém et al. a partir de 4 autores. -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" delimiter="; " delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
        <name-part name="family" text-case="capitalize-first"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <!-- CSL não possui transformação nativa para colocar somente a PRIMEIRA PALAVRA
       do título em caixa alta. A forma abaixo é uma aproximação técnica. -->
  <macro name="title-no-author">
    <text variable="title" text-case="capitalize-first"/>
  </macro>

  <macro name="title">
    <choose>
      <if variable="author editor translator" match="none">
        <text variable="title" text-case="capitalize-first"/>
      </if>
      <else-if type="chapter article-journal article-magazine article-newspaper" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" font-weight="bold"/>
      </else>
    </choose>
  </macro>

  <macro name="container-title">
    <text variable="container-title" font-weight="bold"/>
  </macro>

  <macro name="translator">
    <names variable="translator" prefix="Tradução: " delimiter="; ">
      <name delimiter="; " delimiter-precedes-last="always" initialize="false"/>
    </names>
  </macro>

  <macro name="edition">
    <choose>
      <if variable="edition">
        <choose>
          <if is-numeric="edition">
            <group delimiter=" ">
              <number variable="edition" form="numeric" suffix="."/>
              <text value="ed."/>
            </group>
          </if>
          <else>
            <text variable="edition"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="[s.d.]"/>
      </else>
    </choose>
  </macro>

  <macro name="issued-full">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="[s.d.]"/>
      </else>
    </choose>
  </macro>

  <macro name="publisher">
    <choose>
      <if variable="publisher-place publisher" match="any">
        <choose>
          <if variable="publisher-place">
            <text variable="publisher-place" suffix=": "/>
          </if>
          <else>
            <text value="[S. l.]" suffix=": "/>
          </else>
        </choose>
        <choose>
          <if variable="publisher">
            <text variable="publisher" suffix=", "/>
          </if>
          <else>
            <text value="[s. n.]" suffix=", "/>
          </else>
        </choose>
        <text macro="issued-year"/>
      </if>
      <else>
        <text value="[S. l.: s. n.], "/>
        <text macro="issued-year"/>
      </else>
    </choose>
  </macro>

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: " suffix=". "/>
      </if>
    </choose>
  </macro>

  <macro name="access">
    <choose>
      <if variable="URL">
        <text variable="URL" prefix="Disponível em: " suffix="."/>
        <date variable="accessed" prefix=" Acesso em: ">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year" suffix="."/>
        </date>
      </if>
    </choose>
  </macro>

  <!-- Livro eletrônico: a presença de URL faz o estilo indicar E-book. -->
  <macro name="book-medium">
    <choose>
      <if variable="URL">
        <text value="E-book."/>
      </if>
    </choose>
  </macro>

  <!-- Extensão de livro completo: preencher Pages no Mendeley somente com o total,
       por exemplo 56, para produzir "56 p.". -->
  <macro name="book-extent">
    <choose>
      <if variable="volume">
        <text variable="volume" prefix="v. " suffix=". "/>
      </if>
    </choose>
    <choose>
      <if variable="page">
        <text variable="page" suffix=" p."/>
      </if>
    </choose>
  </macro>

  <macro name="article-locators">
    <group delimiter=", ">
      <text variable="volume" prefix="v. "/>
      <text variable="issue" prefix="n. "/>
      <text variable="page" prefix="p. "/>
    </group>
  </macro>

  <macro name="chapter-locators">
    <group delimiter=", ">
      <text variable="volume" prefix="v. "/>
      <text variable="chapter-number" prefix="cap. "/>
      <text variable="page" prefix="p. "/>
    </group>
  </macro>

  <macro name="editors">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; " delimiter-precedes-last="always" initialize="false">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <label form="short" prefix=" (" suffix=".)"/>
    </names>
  </macro>

  <citation et-al-min="4" et-al-use-first="1" collapse="year" disambiguate-add-year-suffix="true" disambiguate-add-givenname="true" givenname-disambiguation-rule="primary-name-with-initials">
  <sort>
    <key macro="author-short"/>
    <key variable="issued"/>
  </sort>
  <layout prefix="(" suffix=")" delimiter="; ">
    <group>
      <text macro="author-short" suffix=", "/>
      <text macro="issued-year"/>
      <group prefix=", ">
        <label variable="locator" form="short" suffix=" "/>
        <text variable="locator"/>
      </group>
    </group>
  </layout>
</citation><bibliography hanging-indent="false" entry-spacing="1" line-spacing="1">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <choose>

        <!-- LIVRO / MONOGRAFIA NO TODO -->
        <if type="book">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="translator" suffix=". "/>
            <text macro="edition" suffix=". "/>
            <text macro="publisher" suffix=". "/>
            <text macro="book-extent" suffix=" "/>
            <text macro="book-medium" suffix=" "/>
            <text macro="access"/>
          </group>
        </if>

        <!-- CAPÍTULO / PARTE DE MONOGRAFIA -->
        <else-if type="chapter">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text value="In: "/>
            <text macro="editors" suffix=". "/>
            <text macro="container-title" suffix=". "/>
            <text macro="edition" suffix=". "/>
            <text macro="publisher" suffix=". "/>
            <text macro="chapter-locators" suffix=". "/>
            <text macro="doi"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- ARTIGO DE PERIÓDICO -->
        <else-if type="article-journal article-magazine" match="any">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="container-title" suffix=", "/>
            <!-- Correção: a NBR 6023:2025 exige local de publicação do periódico -->
            <text variable="publisher-place" suffix=", "/>
            <text macro="article-locators" suffix=", "/>
            <text macro="issued-full" suffix=". "/>
            <text macro="doi"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- ARTIGO/MATÉRIA DE JORNAL -->
        <else-if type="article-newspaper">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="container-title" suffix=", "/>
            <text variable="publisher-place" suffix=", "/>
            <text macro="article-locators" suffix=", "/>
            <text macro="issued-full" suffix=". "/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- TRABALHO ACADÊMICO -->
        <else-if type="thesis">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="issued-year" suffix=". "/>
            <text variable="genre"/>
            <text variable="number-of-pages" prefix=", " suffix=" f. "/>
            <text variable="publisher" prefix="– " suffix=", "/>
            <text variable="publisher-place" suffix=", "/>
            <text macro="issued-year" suffix=". "/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- RELATÓRIO -->
        <else-if type="report">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="edition" suffix=". "/>
            <text macro="publisher" suffix=". "/>
            <text macro="book-extent" suffix=" "/>
            <text macro="doi"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- PÁGINA WEB -->
        <else-if type="webpage post-weblog" match="any">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text variable="container-title" font-weight="bold" suffix=", "/>
            <text macro="issued-full" suffix=". "/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- TRABALHO EM EVENTO -->
        <else-if type="paper-conference">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text value="In: "/>
            <text variable="event" text-case="uppercase" suffix=". "/>
            <text macro="container-title" suffix=". "/>
            <text variable="publisher-place" suffix=": "/>
            <text variable="publisher" suffix=", "/>
            <text macro="issued-year" suffix=". "/>
            <text variable="page" prefix="p. " suffix=". "/>
            <text macro="doi"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- FALLBACK -->
        <else>
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text variable="publisher-place" suffix=": "/>
            <text variable="publisher" suffix=", "/>
            <text macro="issued-year" suffix=". "/>
            <text macro="doi"/>
            <text macro="access"/>
          </group>
        </else>

      </choose>
    </layout>
  </bibliography>
</style>

